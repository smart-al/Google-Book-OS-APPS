// LiquidGlassShader.agsl — Android AGSL (RuntimeShader)
//
// All child shaders are sampled in *pixel* coordinates and have been pre-scaled
// (cover-crop) to the surface size by LiquidGlassRenderer, so a pixel in
// `photo`, `depthTex` and `maskTex` all line up with `frag`.
//
//   photo     : RGB source image
//   depthTex  : R = depth (1 = near, 0 = far)
//   maskTex   : R = foreground subject mask (1 = subject)
//   motionTex : RGB AI semantic motion mask (R = Clouds/Sky, G = Water, B = Birds/Animals/Foliage, 0 = Static Solid)
//   clockTex  : premultiplied RGBA clock text, panel-sized (origin = panel.xy)

uniform shader photo;
uniform shader depthTex;
uniform shader maskTex;
uniform shader motionTex;
uniform shader clockTex;

uniform float2 res;            // surface size in px
uniform float2 tilt;           // smoothed parallax input, -1..1
uniform float  depthIntensity; // 0..1.5
uniform float  refraction;     // 0..1.5 liquid-glass strength
uniform float  spatial;        // 1 = 3D Spatial Mode on, 0 = flat
uniform float  time;           // seconds
uniform float4 panel;          // glass panel: x, y, w, h (px)
uniform float  clockInFront;   // 0 = behind subject, 1 = floating in front
uniform float  glassBlend;     // 0 = seamless image blend, 1 = frosted glass
uniform float4 baseColor; // RGBA tint for glass panel
uniform float  livingEnabled;  // 1 = animate background, 0 = static
uniform float  livingMode;     // 0 = Clouds, 1 = Ocean, 2 = Breeze, 3 = Aura
uniform float  livingIntensity;// 0..1.5
uniform float  popOut3d;       // 1 = 3DS pop-out boost (cast shadow, lift, micro-orbit)

const float ZERO_PLANE = 0.35;  // depth value that stays "on screen"

float2 clampP(float2 p) { return clamp(p, float2(0.5), res - 0.5); }
float  depthAt(float2 p) { return depthTex.eval(clampP(p)).r; }
float  maskAt(float2 p)  { return maskTex.eval(clampP(p)).r; }
half3  motionAt(float2 p){ return motionTex.eval(clampP(p)).rgb; }
half3  photoAt(float2 p) { return photo.eval(clampP(p)).rgb; }

// Morphological closing approximation + edge-aware glow bridge in shader space:
// keeps bright glowing appendages (e.g. Link's glowing cyan arm) fused to the subject mask.
float closedMaskAt(float2 p, float unit) {
    float c = maskAt(p);
    float r1 = 5.0 * unit;
    float r2 = 11.0 * unit;
    float d1 = max(max(maskAt(p + float2(r1, 0.0)), maskAt(p - float2(r1, 0.0))),
                   max(maskAt(p + float2(0.0, r1)), maskAt(p - float2(0.0, r1))));
    float d2 = max(max(maskAt(p + float2(r2, r2)), maskAt(p - float2(r2, r2))),
                   max(maskAt(p + float2(r2, -r2)), maskAt(p - float2(r2, -r2))));
    float dilated = max(c, max(d1, d2 * 0.92));
    half3 rgb = photoAt(p);
    float lum = dot(float3(rgb), float3(0.299, 0.587, 0.114));
    float cyanGlow = max(0.0, min(float(rgb.g), float(rgb.b)) - float(rgb.r) * 0.65);
    float glowBridge = clamp((cyanGlow * 1.8 + max(0.0, lum - 0.55)) * step(0.22, dilated), 0.0, 1.0);
    return clamp(max(c, mix(c, dilated, 0.45 + 0.50 * glowBridge)), 0.0, 1.0);
}

// Tri-layer scene depth:
//  - Primary foreground subject (closedMask) -> popped near Z-plane (~0.88..0.96)
//  - Main cliff/terrain anchor plane -> plateau-locked to ZERO_PLANE (0.35, zero parallax drift)
//  - Small isolated mid-sky elements (birds / floating leaves) -> aerial mid-sky plane (~0.18)
//  - Distant sky & clouds -> deep recessed background plane (0.0..0.11)
float sceneDepthAt(float2 p, float unit) {
    float rawD = depthAt(p);
    float fg = smoothstep(0.20, 0.65, closedMaskAt(p, unit));
    float probe = 24.0 * unit;
    float dSurround = 0.25 * (
        depthAt(p + float2(probe, 0.0)) +
        depthAt(p - float2(probe, 0.0)) +
        depthAt(p + float2(0.0, probe)) +
        depthAt(p - float2(0.0, probe))
    );

    // Detect small isolated mid-sky elements (birds, floating leaves) surrounded by open sky
    float openSky = 1.0 - smoothstep(0.24, 0.38, dSurround);
    float isolatedBlob = smoothstep(0.03, 0.12, rawD - dSurround) * openSky * (1.0 - fg);

    // Plateau-lock continuous mid-ground cliff/terrain around ZERO_PLANE (0.35) for zero drift
    float terrainBand = (1.0 - smoothstep(0.0, 0.20, abs(rawD - ZERO_PLANE))) * step(0.24, dSurround);
    float bgD = mix(rawD, ZERO_PLANE, 0.85 * terrainBand);

    // Push distant open sky into a deep parallax layer
    float deepSky = (1.0 - smoothstep(0.16, 0.28, rawD)) * openSky;
    bgD = mix(bgD, rawD * 0.42, deepSky);

    // Decouple isolated mid-sky birds/leaves from the rock layer onto an aerial plane
    bgD = mix(bgD, 0.18, isolatedBlob);

    // Fuse foreground character onto a unified high-pop Z-plane so glowing arms never tear
    float fgTarget = max(rawD, 0.88 + 0.07 * popOut3d);
    return mix(bgD, fgTarget, fg);
}

float sdRoundBox(float2 p, float2 b, float r) {
    float2 q = abs(p) - b + r;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

half4 main(float2 frag) {
    float unit = res.y / 1000.0;               // resolution-independent pixel unit
    float2 center = res * 0.5;

    // ---- 1. Depth-driven UV displacement (depth - 0.35) ------------------
    float zoom = 1.0 + 0.075 * depthIntensity * spatial;    // hide revealed borders
    float2 base = (frag - center) / zoom + center;
    float reach = res.y * (0.054 + 0.016 * popOut3d) * depthIntensity * spatial;
    float2 off = clamp(float2(tilt.x, tilt.y), float2(-1.1), float2(1.1));

    // Iterative parallax mapping using tri-layer sceneDepthAt:
    // Foreground pops cleanly, cliff anchor stays stationary at ZERO_PLANE, sky recedes deeply.
    float2 p = base;
    float d = sceneDepthAt(p, unit);
    for (int i = 0; i < 4; i++) {
        p = base + off * (d - ZERO_PLANE) * reach;
        d = sceneDepthAt(p, unit);
    }
    p = clampP(p);

    // ---- 2. Foreground edge + surface normal -----------------------------
    float e = 3.0 * unit + 1.0;
    float fgCenter = closedMaskAt(p, unit);
    float mx = closedMaskAt(p + float2(e, 0), unit) - closedMaskAt(p - float2(e, 0), unit);
    float my = closedMaskAt(p + float2(0, e), unit) - closedMaskAt(p - float2(0, e), unit);
    float2 g = float2(mx, my);
    float edge = clamp(length(g) * 1.25, 0.0, 1.0);
    float2 edgeDir = g / max(length(g), 1e-4);

    float dx = depthAt(p + float2(e, 0)) - depthAt(p - float2(e, 0));
    float dy = depthAt(p + float2(0, e)) - depthAt(p - float2(0, e));
    float3 n = normalize(float3(-dx * 6.5, -dy * 6.5, 1.0));

    // ---- 3. Terrain vs. Sky separation + Mid-Sky Particle Wind Drift -----
    float fgSoft = smoothstep(0.22, 0.62, fgCenter);
    // Keep the moving background glued to the subject: fade motion out near its edges
    float ring = 16.0 * unit;
    float nearFg = max(max(maskAt(p + float2(ring, 0)), maskAt(p - float2(ring, 0))),
                       max(maskAt(p + float2(0, ring)), maskAt(p - float2(0, ring))));
    float edgeGuard = 1.0 - smoothstep(0.15, 0.6, max(nearFg, fgSoft));

    // Regional surround check to separate static cliff terrain from sky & isolated mid-sky particles
    float skyProbe = 26.0 * unit;
    float dSurround = 0.25 * (
        depthAt(p + float2(skyProbe, 0.0)) +
        depthAt(p - float2(skyProbe, 0.0)) +
        depthAt(p + float2(0.0, skyProbe)) +
        depthAt(p - float2(0.0, skyProbe))
    );
    half3 colCenter = photoAt(p);
    half3 colSurround = 0.25 * (
        photoAt(p + float2(skyProbe, 0.0)) +
        photoAt(p - float2(skyProbe, 0.0)) +
        photoAt(p + float2(0.0, skyProbe)) +
        photoAt(p - float2(0.0, skyProbe))
    );
    float lumDiff = abs(dot(float3(colCenter - colSurround), float3(0.299, 0.587, 0.114)));
    float2 uv = p / max(res, float2(1.0));

    // Stationary cliff/terrain anchor guard: rock masses near ZERO_PLANE stay stationary
    float openSkyMask = (1.0 - smoothstep(0.24, 0.36, dSurround)) * smoothstep(0.88, 0.16, uv.y);

    // Isolated mid-sky elements (birds and floating leaves): small features contrasted against open sky
    float rawLocalD = depthAt(p);
    half3 aiM = motionAt(p);
    float cloudMask  = float(aiM.r);
    float waterMask  = float(aiM.g);
    float spriteMask = float(aiM.b);

    float midSkySprite = edgeGuard * max(
        spriteMask,
        openSkyMask * clamp(smoothstep(0.05, 0.18, lumDiff) + smoothstep(0.03, 0.12, rawLocalD - dSurround), 0.0, 1.0)
    );
    float2 windDrift = float2(
        sin(time * 1.65 + uv.y * 13.0 + uv.x * 8.0) * 7.5,
        cos(time * 2.15 + uv.x * 16.0 - uv.y * 10.0) * 4.0
    ) * unit * midSkySprite * livingEnabled;

    float bgActive = edgeGuard * livingEnabled * max(0.75, livingIntensity) + livingMode * 0.0;
    float waterW  = waterMask * bgActive;
    float spriteW = spriteMask * bgActive;
    float cloudW  = max(cloudMask, openSkyMask * (1.0 - 0.75 * midSkySprite) * (1.0 - waterMask)) * bgActive;

    // Static background structures (cliffs, rocks, buildings, ground) have cloudW=0, waterW=0, spriteW=0 -> stay 100% solid.
    float2 waterDelta = float2(0.0);
    float bgShimmer = 0.0;
    if (waterW > 0.001) {
        float w1 = sin(uv.y * 38.0 - time * 2.6 + uv.x * 11.0);
        float w2 = cos(uv.y * 24.0 + time * 1.9 - uv.x * 16.0);
        waterDelta = float2((w1 * 11.5 + w2 * 6.0) * unit, (w1 * 4.5 - w2 * 3.0) * unit) * waterW;
        bgShimmer += pow(max(0.0, w1 * 0.5 + w2 * 0.5), 3.0) * 0.09 * waterW;
    }

    float2 foliageDelta = float2(0.0);
    if (spriteW > 0.001) {
        float gust = sin(uv.x * 14.0 + uv.y * 9.0 - time * 1.85) * 0.65
                   + cos(uv.x * 7.0 - uv.y * 11.0 + time * 1.35) * 0.35;
        foliageDelta = float2(gust * 11.0 * unit, sin(uv.x * 10.0 + time * 1.45) * 4.5 * unit) * spriteW;
    }

    float2 pSample = clampP(p + windDrift + waterDelta + foliageDelta);
    float disp = refraction * edge * 2.5 * unit * (0.6 + 0.4 * spatial);
    half3 basePhoto;
    basePhoto.r = photoAt(pSample + edgeDir * disp).r;
    basePhoto.g = photoAt(pSample).g;
    basePhoto.b = photoAt(pSample - edgeDir * disp).b;

    half3 col = basePhoto;
    if (cloudW > 0.001) {
        // Clouds & Sky: dual-phase continuous flow advection restricted strictly to movable sky/cloud regions
        float flowSpeed = 0.18;
        float p0 = fract(time * flowSpeed);
        float p1 = fract(time * flowSpeed + 0.5);
        float blendW = abs(2.0 * p0 - 1.0);
        float travel = 95.0 * unit * cloudW;
        float billow = sin(uv.y * 10.0 + time * 0.8) * 10.0 * unit * cloudW;

        float2 off0 = float2((p0 - 0.5) * travel, billow * (1.0 - p0));
        float2 off1 = float2((p1 - 0.5) * travel, billow * (1.0 - p1));
        half3 c0 = photoAt(pSample - off0);
        half3 c1 = photoAt(pSample - off1);
        half3 cloudFlow = mix(c0, c1, half(blendW));
        col = mix(basePhoto, cloudFlow, half(clamp(cloudW, 0.0, 1.0)));
        bgShimmer += max(0.0, sin(uv.x * 8.0 - time * 0.9 + uv.y * 4.0)) * 0.03 * cloudW;
    }

    // ---- 3b. 3D Pop & Rim Separation: Ambient Occlusion + Drop-Shadow ----
    if (spatial > 0.01) {
        float bgOnly = 1.0 - fgSoft;
        // Soft contact Ambient Occlusion (AO) halo right behind the foreground cutout
        float aoRad = 11.0 * unit;
        float aoRing = 0.25 * (
            closedMaskAt(p + float2(aoRad, 0.0), unit) +
            closedMaskAt(p - float2(aoRad, 0.0), unit) +
            closedMaskAt(p + float2(0.0, aoRad), unit) +
            closedMaskAt(p - float2(0.0, aoRad), unit)
        );
        float contactAo = aoRing * bgOnly * (0.10 + 0.05 * popOut3d) * clamp(depthIntensity, 0.3, 1.5);

        // Multi-tap parallax-reactive drop-shadow behind the foreground cutout
        float2 shadowOffset = (off * 14.0 + float2(4.0, 6.5)) * unit * (0.65 + 0.35 * popOut3d);
        float dropNear = closedMaskAt(p - shadowOffset * 0.65, unit);
        float dropFar  = closedMaskAt(p - shadowOffset * 1.15, unit);
        float dropShadow = (0.6 * dropNear + 0.4 * dropFar) * bgOnly * (0.12 + 0.08 * popOut3d) * clamp(depthIntensity, 0.3, 1.5);

        col *= half(clamp(1.0 - (contactAo + dropShadow), 0.68, 1.0));
    }

    // ---- 4. Dynamic specular sheen + 3D Rim Separation on the subject ----
    float3 L = normalize(float3(-tilt.x * 0.9 + 0.25 * sin(time * 0.4),
                                -tilt.y * 0.9 - 0.35, 0.65));
    float3 H = normalize(L + float3(0, 0, 1));
    float spec = pow(max(dot(n, H), 0.0), 36.0);
    float sheen = spec * refraction * (0.35 + 1.6 * edge + 0.5 * fgSoft);
    float rim = edge * (0.14 * spatial + 0.16 * refraction) * (0.55 + 0.45 * dot(normalize(edgeDir + 1e-4), L.xy)) * (0.4 + 0.6 * fgSoft);
    col += half3(sheen + rim + bgShimmer);

    // ---- 5. Frosted Liquid-Glass panel (sandwiched behind the subject) ----
    float2 pc = panel.xy + panel.zw * 0.5 + tilt * 5.0 * unit * spatial;
    float2 local = frag - pc;
    float radius = min(panel.z, panel.w) * 0.32;
    float sd = sdRoundBox(local, panel.zw * 0.5, radius);
    float inside = 1.0 - smoothstep(-1.5, 0.75, sd);

    half3 result = col;
    if (inside > 0.0 || sd < 40.0 * unit) {
        // Lens refraction: pixels near the rim bend inward like a liquid bead.
        float lens = smoothstep(-34.0 * unit, 0.0, sd);
        float2 dir = local / max(length(local), 1.0);
        float2 q = p - dir * lens * refraction * 26.0 * unit;

        // Frosted blur (golden-angle disc kernel)
        half3 blur = half3(0);
        float rad = (10.0 + 6.0 * refraction) * unit;
        for (int i = 0; i < 12; i++) {
            float a = float(i) * 2.39996;
            float r = sqrt((float(i) + 0.5) / 12.0) * rad;
            blur += photoAt(q + float2(cos(a), sin(a)) * r);
        }
        blur /= 12.0;

        // Chromatic split on the lens rim
        float cd = lens * refraction * 5.0 * unit;
        blur.r = mix(blur.r, photoAt(q + dir * cd).r, 0.6);
        blur.b = mix(blur.b, photoAt(q - dir * cd).b, 0.6);

        // Blend frosted blur with the actual image colors under the clock
        half3 imageUnder = photoAt(p);
        half3 ambientTint = photoAt(pc);
        half3 glass = mix(imageUnder, blur, half(0.25 + 0.65 * glassBlend));
        glass = mix(glass, glass * (ambientTint * 0.75 + 0.35), half(0.28));
        glass = mix(glass, glass * half3(baseColor.rgb), half(0.55 * baseColor.a));

        // Specular rim highlight (brighter toward the light)
        float rimBand = smoothstep(-3.0 * unit, 0.0, sd) * (1.0 - smoothstep(0.0, 1.5 * unit, sd));
        float facing = 0.5 + 0.5 * dot(dir, normalize(L.xy + 1e-4));
        glass += half3(rimBand * (0.35 + 0.65 * facing) * (0.5 + 0.5 * refraction));

        // Inner top sheen
        float topSheen = smoothstep(0.0, -panel.w * 0.5, local.y) * 0.06 * (0.4 + 0.6 * glassBlend);
        glass += half3(topSheen);

        // Clock text living on the glass
        float2 tp = frag - panel.xy;
        if (tp.x >= 0.0 && tp.y >= 0.0 && tp.x < panel.z && tp.y < panel.w) {
            half4 c = clockTex.eval(tp);
            glass = glass * (1.0 - c.a) + c.rgb;
        }

        // Dissolve glass panel seamlessly into image
        float panelAlpha = inside * (0.35 + 0.65 * glassBlend);
        result = mix(col, glass, half(panelAlpha));
    }

    // ---- 6. Depth occlusion: the subject sits in front of the glass -------
    float fg = smoothstep(0.42, 0.56, fgCenter);
    float inFront = step(ZERO_PLANE, d) * (1.0 - clockInFront);            // only truly-near pixels occlude
    result = mix(result, col, half(fg * inFront));

    return half4(result, 1.0);
}
